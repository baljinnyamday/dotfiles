# ~/.config/git/os.gitconfig on macOS -- symlinked from ~/mac-dotfiles/git/os-darwin.gitconfig
# Full Homebrew paths, so apps started from the Dock (no shell PATH) still find them.
[gpg]
	program = /opt/homebrew/bin/gpg
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
