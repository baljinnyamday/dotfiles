# ~/.gitconfig -- symlinked from ~/mac-dotfiles/git/.gitconfig
# Identity and signing live in ~/.gitconfig.local (not tracked), e.g.
#   [user]   name = ... / email = ... / signingkey = ...
#   [commit] gpgsign = true
[core]
	pager = delta
	editor = cursor --wait
	fsmonitor = true
	untrackedCache = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[branch]
	sort = -committerdate
[merge]
	conflictStyle = zdiff3
[interactive]
	diffFilter = delta --color-only
[delta]
	# Shared by `git diff` and lazygit (its diffRenderers just run `delta --paging=never`)
	navigate = true
	dark = true
	line-numbers = true
	syntax-theme = Catppuccin Mocha
[gpg]
	program = /opt/homebrew/bin/gpg
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
