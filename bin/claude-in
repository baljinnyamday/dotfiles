#!/bin/zsh
# Open Claude Code in a folder: a new cmux sidebar tab when run inside cmux,
# otherwise a new Ghostty window (cmux only takes commands from its own terminals; Linux has no cmux).
# Usage: claude-in <folder> [claude args...]
#   claude-in bagsh                 # ~/coding/bagsh
#   claude-in ~/some/path --model opus

CODING_DIR="$HOME/coding"

[[ -n "$1" ]] || { echo "usage: claude-in <folder> [claude args...]" >&2; exit 1 }
name="$1"; shift; dir="$name"
[[ -d "$dir" ]] || dir="$CODING_DIR/$dir"
[[ -d "$dir" ]] || { echo "no such folder: $name" >&2; exit 1 }

if [[ -n "$CMUX_WORKSPACE_ID" ]] && command -v cmux >/dev/null; then
  # plain `claude`, not ~/.local/bin/claude: the new shell resolves it to cmux's wrapper, which
  # injects the hooks behind notifications, agent status and session restore
  cmux new-workspace --name "${dir:A:t}" --cwd "${dir:A}" --focus true \
    --command "claude ${(j: :)${(q)@}}"
elif [[ $OSTYPE == darwin* ]]; then
  open -na Ghostty.app --args --working-directory="${dir:A}" -e "$HOME/.local/bin/claude" "$@"
else
  ghostty --working-directory="${dir:A}" -e "$HOME/.local/bin/claude" "$@" &>/dev/null &!
fi
