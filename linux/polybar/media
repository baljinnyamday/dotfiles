#!/usr/bin/env bash
# Polybar module: what's playing in any MPRIS player (Chrome, Spotify, ...).
# playerctl --follow prints a line on every change and an empty one when the player closes,
# and an empty line hides the module.
set -uo pipefail

playerctl --follow metadata --format $'{{status}}\t{{artist}}\t{{title}}' 2>/dev/null |
  while IFS=$'\t' read -r status artist title; do
    track="${artist:+$artist - }$title"
    case $status in
      Playing) echo "󰐊 $track" ;;
      Paused) echo "󰏤 $track" ;;
      *) echo ;;
    esac
  done
